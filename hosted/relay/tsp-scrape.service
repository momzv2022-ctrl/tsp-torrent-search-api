# systemd unit for the tracker scrape service. Installed by install.sh.
# Loopback only; the relay Worker is the one thing that talks to it.

[Unit]
Description=TSP tracker scrape (BEP 15)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/tsp-relay/scrape.py
Restart=always
RestartSec=3
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
