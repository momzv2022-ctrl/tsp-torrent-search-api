{
  "id": "torrentdownloads",
  "upstream": "torrentdownloads",
  "name": "TorrentDownloads",
  "site": "https://www.torrentdownloads.pro",
  "kind": "rss",
  "fixture": "torrentdownloads.xml",
  "enabled": true,
  "match": "name",
  "note": "Searches any word of the query (\"Bethlehem Kudumba Unit\" answered with fifty Law & Order episodes), so it is held to the name. Answers Cloudflare's addresses as of 2026-09-11, with a 521 now and then; on 2026-09-05 it did not. Carries Indian regional releases the other reachable indexes lack.",
  "origins": [
    "https://www.torrentdownloads.pro"
  ],
  "categories": [
    "anime",
    "apps",
    "books",
    "games",
    "movies",
    "music",
    "series",
    "other"
  ],
  "cloudflare": true,
  "request": {
    "method": "GET",
    "path": "/rss.xml",
    "query": {
      "type": "search",
      "search": "{q}"
    }
  },
  "fields": {
    "name": "title",
    "infohash": "info_hash",
    "size_bytes": "size",
    "seeders": "seeders",
    "leechers": "leechers",
    "first_seen": "pubDate",
    "description_url": {
      "from": "link"
    }
  }
}
